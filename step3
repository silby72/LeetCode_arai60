class Solution:
    def isValid(s: str) -> bool:

        if not isinstance(s, str):
            raise TypeError(f"Error: {type(s)}")
        
        open_to_close = {"(": ")", "{": "}", "[": "]"}
        open_brackets = []

        for char in s:
            if char in open_to_close:
                open_brackets.append(char)
            else:
                top_element = open_brackets.pop() if open_brackets else '#'
                
                if open_to_close.get(top_element) != char:
                    return False

        return len(open_brackets) == 0