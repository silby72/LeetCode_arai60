class Solution:
    def isValid(self, s: str) -> bool:
        if not isinstance(s, str):
            raise TypeError(f"Error: {type(s)}")
        
        open_to_close = {"(": ")", "{": "}", "[": "]"}
        open_brackets = []

        for char in s:
            if char in open_to_close:
                open_brackets.append(char)
            else:
                top_element = open_brackets.pop() if open_brackets else None
                expected_closed_bracket = open_to_close.get(top_element)
                
                if not expected_closed_bracket or expected_closed_bracket != char:
                    return False

        return not open_brackets