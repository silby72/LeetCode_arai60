class ListNode:
    def __init__(self, x):
        self.val = x
        self.next = None

class Solution:
    def hasCycle(self, head: Optional[ListNode]) -> bool:
        slower = head
        faster = head

        while faster is not None and faster.next is not None:
            slower = slower.next
            faster = slower.next.next

            if slower == faster:
                return True

        return False