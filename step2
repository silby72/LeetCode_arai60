class ListNode:
    def __init__(self, x):
        self.val = x
        self.next = None

class Solution:
    def posCycle(self, head):
        faster = head
        slower = head

        while faster is not None and faster.next is not None:
            slower = slower.next
            faster = faster.next.next

            if faster == slower :
                pointer = head
                while pointer != slower:
                    pointer = pointer.next
                    slower = slower.next    
                return slower

        return None