class ListNode:
    def __init__(self, x):
        self.val = x
        self.next = None

class Solution:
    def hasCycle(self, head):
        faster = head
        slower = head

        while faster is not None and faster.next is not None:
            slower = slower.next
            faster = faster.next.next

            if faster == slower :
                return True

        return False